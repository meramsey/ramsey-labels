<?xml version="1.0"?>
<ruleset name="Ramsey Labels">
    <description>Full WordPress standards; findings remain release gates.</description>
    <file>ramsey-labels-independent.php</file><file>public/src/ramsey-labels.php</file><file>uninstall.php</file><file>includes</file>
    <arg name="extensions" value="php"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>includes/(Data|Migration|Plugin|Schema|Store)\.php$</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.Capabilities">
        <properties><property name="custom_capabilities" type="array">
            <element value="manage_woocommerce"/><element value="edit_products"/>
            <element value="edit_shop_orders"/><element value="edit_shop_coupons"/>
        </property></properties>
    </rule>
    <config name="testVersion" value="7.4-"/>
</ruleset>
