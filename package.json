{
    "name": "ramsey-labels",
    "version": "1.0.0-rc.9",
    "private": true,
    "license": "GPL-2.0-or-later",
    "scripts": {
        "test": "node --test tests/Unit/*.test.cjs",
        "lint": "eslint assets tests bin/*.cjs && prettier --check assets tests bin/*.cjs *.cjs *.mjs package.json",
        "format": "prettier --write assets tests bin/*.cjs *.cjs *.mjs package.json",
        "test:e2e": "playwright test",
        "build": "python3 bin/build.py"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "@undecaf/zbar-wasm": "0.11.0",
        "eslint": "10.14.0",
        "globals": "16.5.0",
        "prettier": "3.9.10",
        "zxing-wasm": "2.2.4"
    },
    "overrides": {
        "minimatch": "11.0.1"
    }
}
