{
  "name": "meramsey/ramsey-labels",
  "description": "Independent WooCommerce label designer and print engine",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.3",
    "phpstan/phpstan": "^2.1",
    "php-stubs/wordpress-stubs": "^6.8",
    "php-stubs/woocommerce-stubs": "^11.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
  },
  "config": {"allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}, "sort-packages": true},
  "scripts": {"test": "phpunit", "lint": "phpcs", "analyse": "phpstan analyse --memory-limit=1G"}
}
